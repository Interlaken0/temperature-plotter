# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Electron Forge build output
out/
dist/
release/
build/
.webpack/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
logs/
*.log

# Environment variables
.env
.env.local
.env.*.local

# Cache
.cache/
.parcel-cache/
.next/

# Webpack / Babel
*.map

# Tailwind / PostCSS
tailwind.config.js.bak

# DLL and hardware binaries (do NOT commit vendor files)
assets/*.dll
assets/*.so
assets/*.dylib
src/main/dll/*.dll
src/main/dll/*.so
src/main/dll/*.dylib

# Test artifacts (keep tests, ignore only cache files)
jest-cache/
coverage/
*.lcov
lccov.info

# Test reports (auto-generated files)
evidence/test-reports/test-summary.txt

# Misc
tmp/
temp/
*.bak
*.swp

# Testing backup files
__tests__/*.bak

# CSV data files
*.csv

# Generated documents (source is tracked, binaries are not)
portfolio-evidence.docx
~$portfolio-evidence.docx

# Mermaid processing artifacts
mermaid-filter.err
